---
import Icon, { type IconName } from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { getStrings, localePath } from '~/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getStrings(lang);

const ICONS: IconName[] = ['book', 'pill', 'flask', 'map', 'spark', 'lock'];
const IDS = ['diseases', 'medicines', 'diagnostics', 'directory', 'ai', 'records'];
---

<!-- Alternating band: the platform modules, in a 3×2 symmetric grid. -->
<section id="modules" class="gh-section gh-band" aria-labelledby="modules-title">
  <div class="gh-shell">
    <SectionHead
      id="modules-title"
      eyebrow={t.home.modules.eyebrow}
      title={t.home.modules.title}
      lead={t.home.modules.lead}
      align="center"
    />

    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.home.modules.items.map((item, i) => (
          <a
            id={IDS[i]}
            href={localePath(lang, 'platform')}
            class="gh-card gh-card-hover group relative flex h-full flex-col overflow-hidden p-6 scroll-mt-28"
            data-reveal
          >
            <span
              class="pointer-events-none absolute inset-x-0 top-0 h-px opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style="background-image:linear-gradient(90deg,transparent,var(--color-brand-400),transparent)"
              aria-hidden="true"
            />
            <div class="flex items-start justify-between gap-3">
              <span class="gh-icon-tile gh-icon-tile-lg">
                <Icon name={ICONS[i]} class="h-6 w-6" />
              </span>
              <span class="gh-chip !border-transparent !bg-[var(--color-surface-2)] !text-[0.68rem]">
                {item.tag}
              </span>
            </div>
            <h3 class="mt-5 font-display text-[1.05rem] font-bold text-[var(--color-fg)]">{item.title}</h3>
            <p class="mt-2 flex-1 text-[0.86rem] leading-relaxed text-[var(--color-fg-muted)]">{item.desc}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
