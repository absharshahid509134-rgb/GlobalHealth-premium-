---
import Icon, { type IconName } from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { getStrings } from '~/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getStrings(lang);

const ICONS: IconName[] = ['stethoscope', 'file', 'shield', 'alert'];
---

<!-- Trust & safety: the honesty band, immediately before the FAQ. -->
<section id="standards" class="gh-section gh-band" aria-labelledby="standards-title">
  <div class="gh-shell">
    <div class="gh-split gh-split-start">
      <div data-reveal>
        <SectionHead
          id="standards-title"
          eyebrow={t.home.standards.eyebrow}
          title={t.home.standards.title}
          lead={t.home.standards.lead}
        />

        <p class="mt-7 flex items-start gap-3 rounded-2xl border border-brand-200/70 bg-brand-50/70 p-4 text-[0.82rem] leading-relaxed text-brand-900 dark:border-brand-400/25 dark:bg-brand-500/10 dark:text-brand-100">
          <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0" />
          <span>{t.home.standards.note}</span>
        </p>
      </div>

      <ul class="grid gap-3.5 sm:grid-cols-2">
        {
          t.home.standards.items.map((item, i) => (
            <li class="gh-card flex h-full flex-col p-5" data-reveal>
              <span class="gh-icon-tile gh-icon-tile-sm">
                <Icon name={ICONS[i]} class="h-4 w-4" />
              </span>
              <h3 class="mt-3.5 text-[0.92rem] font-bold text-[var(--color-fg)]">{item.title}</h3>
              <p class="mt-1.5 text-[0.83rem] leading-relaxed text-[var(--color-fg-muted)]">{item.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
