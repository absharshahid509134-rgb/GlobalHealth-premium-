---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { getStrings, localePath } from '~/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getStrings(lang);
const regions = t.globalTeaser.items;
---

<!-- Worldwide coverage preview. Six equal region cards, then a link to the
     full global page where the emergency directory lives. -->
<section class="gh-section gh-band" aria-labelledby="global-teaser-title">
  <div class="gh-shell">
    <div class="gh-split">
      <div data-reveal>
        <SectionHead
          id="global-teaser-title"
          eyebrow={t.globalTeaser.eyebrow}
          title={t.globalTeaser.title}
          lead={t.globalTeaser.lead}
        />
        <a href={localePath(lang, 'global')} class="gh-btn gh-btn-md gh-btn-primary mt-7">
          {t.globalTeaser.cta}
          <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
        </a>
      </div>

      <ul class="grid gap-3 sm:grid-cols-2">
        {
          regions.map((r) => (
            <li class="gh-card p-5" data-reveal>
              <div class="flex items-center gap-2.5">
                <span class="gh-icon-tile h-8 w-8 shrink-0">
                  <Icon name="globe" class="h-4 w-4" />
                </span>
                <h3 class="text-[0.92rem] font-bold text-[var(--color-fg)]">{r.region}</h3>
              </div>
              <p class="mt-3 text-[0.8rem] leading-relaxed text-[var(--color-fg-muted)]">{r.countries}</p>
              <p class="mt-2 text-[0.76rem] font-semibold text-brand-700 dark:text-brand-300">{r.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
