---
import Icon from '../Icon.astro';
import { getStrings, localePath } from '~/i18n';

/**
 * Hero.
 *
 * Left: the promise and the search entry point.
 * Right: a CSS/SVG "vitals card" — deliberately built from markup rather than
 * an image so it is crisp at any density, themeable, and costs no bytes of
 * bitmap. The two columns are a strict 1fr 1fr split, so the composition is
 * mirrored at every breakpoint.
 */
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getStrings(lang);

const SUGGESTIONS = t.hero.suggestions;
---

<section class="gh-aurora relative overflow-hidden" aria-labelledby="hero-title">
  <div class="gh-grid-lines pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>

  <div class="gh-shell relative">
    <div class="gh-sym-section grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      {/* ---------------- Copy column ---------------- */}
      <div class="text-center lg:text-start">
        <p class="gh-eyebrow inline-flex">
          <span class="gh-anim-pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
          {t.hero.badge}
        </p>

        <h1 id="hero-title" class="gh-display-1 mt-6 text-[var(--color-fg)]">
          {t.hero.title} <span class="gh-gradient-text">{t.hero.titleAccent}</span>
        </h1>

        <p class="gh-lead mx-auto mt-6 max-w-xl lg:mx-0">{t.hero.lead}</p>

        {/* Search — the primary action, not a secondary link. */}
        <div class="mx-auto mt-9 max-w-xl lg:mx-0">
          <button
            type="button"
            class="group flex w-full items-center gap-3 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] px-4 py-3.5 text-start shadow-[var(--shadow-sm)] transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-[var(--shadow-md)]"
            data-open-palette
            aria-label={t.a11y.openSearch}
            aria-haspopup="dialog"
          >
            <Icon name="search" class="h-5 w-5 shrink-0 text-[var(--color-fg-subtle)] transition-colors group-hover:text-brand-600" />
            <span class="min-w-0 flex-1 truncate text-[0.92rem] text-[var(--color-fg-subtle)]">
              {t.hero.searchPlaceholder}
            </span>
            <kbd class="hidden shrink-0 items-center gap-1 rounded-lg border border-[var(--color-line)] bg-[var(--color-surface-2)] px-2 py-1 font-sans text-[0.68rem] font-bold text-[var(--color-fg-subtle)] sm:inline-flex">
              ⌘ {t.nav.searchKey}
            </kbd>
          </button>

          <div class="mt-3.5 flex flex-wrap items-center gap-1.5">
            <span class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--color-fg-subtle)]">
              {t.hero.popular}
            </span>
            {SUGGESTIONS.map((s) => (
              <button
                type="button"
                class="gh-chip !text-[0.75rem] transition hover:border-brand-300 hover:bg-brand-50 hover:text-brand-800 dark:hover:bg-brand-500/10 dark:hover:text-brand-200"
                data-open-palette
                data-prefill={s}
              >
                {s}
              </button>
            ))}
          </div>
        </div>

        {/* Symmetric CTA pair */}
        <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a href={localePath(lang, 'platform')} class="gh-btn gh-btn-lg gh-btn-primary">
            {t.hero.primary}
            <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
          </a>
          <a href={localePath(lang, 'platform') + '#ai'} class="gh-btn gh-btn-lg gh-btn-ghost">
            <Icon name="spark" class="h-4 w-4 text-accent-500" />
            {t.hero.secondary}
          </a>
        </div>

        <p class="mt-5 flex items-center justify-center gap-2 text-[0.78rem] text-[var(--color-fg-subtle)] lg:justify-start">
          <Icon name="shield" class="h-4 w-4 shrink-0 text-brand-500" />
          <span>{t.hero.note}</span>
        </p>
      </div>

      {/* ---------------- Visual column ---------------- */}
      <div class="relative pb-12 lg:pb-0" aria-hidden="true">
        <div class="gh-anim-float relative">
          {/* Card 1 — vitals trend */}
          <div class="gh-card overflow-hidden p-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-[0.72rem] font-bold uppercase tracking-wider text-[var(--color-fg-subtle)]">
                  {t.home.modules.items[0].tag}
                </p>
                <p class="mt-1 font-display text-[1.05rem] font-bold text-[var(--color-fg)]">
                  {t.home.modules.items[0].title}
                </p>
              </div>
              <span class="gh-icon-tile gh-icon-tile-sm">
                <Icon name="activity" class="h-4 w-4" />
              </span>
            </div>

            <svg viewBox="0 0 320 92" class="mt-5 h-24 w-full" fill="none" preserveAspectRatio="none">
              <defs>
                <linearGradient id="gh-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.35" />
                  <stop offset="100%" stop-color="var(--color-brand-400)" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path
                d="M0 68 L34 60 L60 64 L88 44 L112 52 L140 38 L164 46 L192 28 L214 36 L242 22 L266 30 L292 18 L320 24 L320 92 L0 92 Z"
                fill="url(#gh-area)"
              />
              <path
                d="M0 68 L34 60 L60 64 L88 44 L112 52 L140 38 L164 46 L192 28 L214 36 L242 22 L266 30 L292 18 L320 24"
                stroke="var(--color-brand-500)"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <ul class="mt-4 divide-y divide-[var(--color-line)] overflow-hidden rounded-xl border border-[var(--color-line)]">
              {[
                { icon: 'activity' as const, label: t.home.modules.items[0].title, badge: t.common.lastReviewed },
                { icon: 'pill' as const, label: t.home.modules.items[1].title, badge: t.common.updated },
                { icon: 'flask' as const, label: t.home.modules.items[2].title, badge: t.common.new },
              ].map((row) => (
                <li class="flex items-center gap-2.5 bg-[var(--color-surface-2)] px-3.5 py-2.5">
                  <Icon name={row.icon} class="h-3.5 w-3.5 shrink-0 text-brand-600 dark:text-brand-400" />
                  <span class="min-w-0 flex-1 truncate text-[0.78rem] font-semibold text-[var(--color-fg)]">
                    {row.label}
                  </span>
                  <span class="shrink-0 rounded-full bg-[var(--color-surface)] px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-wide text-[var(--color-fg-subtle)]">
                    {row.badge}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {/* Card 2 — assistant */}
          <div class="gh-card absolute -bottom-8 -start-4 w-[min(19rem,86%)] p-4 shadow-[var(--shadow-lg)] sm:-start-8">
            <div class="flex items-center gap-2.5">
              <span class="gh-icon-tile gh-icon-tile-sm !bg-accent-50 !text-accent-600 dark:!bg-accent-500/15 dark:!text-accent-300">
                <Icon name="spark" class="h-4 w-4" />
              </span>
              <div class="min-w-0">
                <p class="truncate text-[0.82rem] font-bold text-[var(--color-fg)]">
                  {t.home.modules.items[4].title}
                </p>
                <p class="truncate text-[0.68rem] text-[var(--color-fg-subtle)]">{t.home.modules.items[4].tag}</p>
              </div>
            </div>
            <div class="mt-3 space-y-1.5">
              <div class="h-2 w-4/5 rounded-full bg-[var(--color-surface-3)]"></div>
              <div class="h-2 w-3/5 rounded-full bg-[var(--color-surface-3)]"></div>
            </div>
            <div class="mt-3 flex items-center gap-1.5">
              <span class="gh-typing-dot inline-block h-1.5 w-1.5 rounded-full bg-brand-400"></span>
              <span class="gh-typing-dot inline-block h-1.5 w-1.5 rounded-full bg-brand-400"></span>
              <span class="gh-typing-dot inline-block h-1.5 w-1.5 rounded-full bg-brand-400"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Trust bar — a symmetric, four-up strip of commitments */}
    <div class="border-t border-[var(--color-line)] py-8">
      <p class="text-center text-[0.72rem] font-bold uppercase tracking-[0.12em] text-[var(--color-fg-subtle)]">
        {t.trustBar.label}
      </p>
      <ul class="mx-auto mt-4 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-4">
        {
          t.trustBar.items.map((item) => (
            <li class="flex items-center justify-center gap-2 text-center text-[0.82rem] font-semibold text-[var(--color-fg-muted)]">
              <Icon name="check" class="h-4 w-4 shrink-0 text-brand-500" />
              <span class="text-start">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
