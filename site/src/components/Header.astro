---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { getStrings, LOCALES, localePath } from '~/i18n';
import { PAGES, pageLabel } from '~/data/pages';

interface Props {
  lang: string;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = getStrings(lang);

const navPages = PAGES.filter((p) => p.inNav);
const isActive = (p: (typeof PAGES)[number]) => p.path === currentPath;
---

<header
  id="site-header"
  class="gh-no-print sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300"
  data-header
>
  <div class="gh-shell">
    <div class="gh-sym-navbar flex h-[4.25rem] items-center gap-3">
      {/* ---------------- Zone 1 · brand ---------------- */}
      <a
        href={localePath(lang)}
        class="justify-self-start rounded-lg"
        aria-label={`${t.site.name} — ${t.nav.home}`}
      >
        <Logo />
      </a>

      {/* ---------------- Zone 2 · primary nav (centred) ---------------- */}
      <nav class="hidden justify-self-center lg:block" aria-label={t.a11y.mainNav}>
        <ul class="flex items-center gap-0.5">
          {
            navPages.map((page) => {
              const label = pageLabel(t, page.titleKey);
              const active = isActive(page);
              return (
                <li>
                  <a
                    href={localePath(lang, page.path)}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'relative inline-flex items-center rounded-lg px-3 py-2 text-[0.9rem] font-semibold transition-colors duration-150',
                      active
                        ? 'text-brand-700 dark:text-brand-300'
                        : 'text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]',
                    ]}
                  >
                    {label}
                    {active && (
                      <span
                        class="absolute inset-x-3 -bottom-0.5 h-0.5 rounded-full bg-brand-500"
                        aria-hidden="true"
                      />
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      {/* ---------------- Zone 3 · actions ---------------- */}
      <div class="ms-auto flex items-center gap-1.5 lg:ms-0 lg:justify-self-end">
        {/* Emergency signposting — the most important action in the header. */}
        <a
          href={localePath(lang, 'global') + '#emergency'}
          class="gh-btn gh-btn-sm gh-btn-quiet hidden text-urgent-700 hover:bg-urgent-50 hover:text-urgent-800 md:inline-flex dark:text-urgent-400 dark:hover:bg-urgent-500/10"
        >
          <Icon name="phone" class="h-4 w-4" />
          <span class="hidden xl:inline">{t.nav.emergency}</span>
        </a>

        {/* Search */}
        <button
          type="button"
          class="gh-btn gh-btn-sm gh-btn-quiet"
          data-open-palette
          aria-label={t.a11y.openSearch}
          aria-haspopup="dialog"
          aria-controls="gh-command-palette"
        >
          <Icon name="search" class="h-4 w-4" />
        </button>

        {/* Language */}
        <div class="relative" data-lang-menu>
          <button
            type="button"
            class="gh-btn gh-btn-sm gh-btn-quiet"
            aria-label={t.a11y.languageSwitch}
            aria-haspopup="true"
            aria-expanded="false"
            data-lang-toggle
          >
            <Icon name="globe" class="h-4 w-4" />
            <span class="hidden text-[0.8rem] font-bold uppercase sm:inline">{lang}</span>
          </button>

          <div
            class="invisible absolute end-0 top-full z-50 mt-2 w-64 origin-top-right scale-95 overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)] opacity-0 shadow-[var(--shadow-lg)] transition duration-150"
            data-lang-panel
          >
            <p class="border-b border-[var(--color-line)] px-3.5 py-2.5 text-[0.7rem] font-bold uppercase tracking-wider text-[var(--color-fg-subtle)]">
              {t.a11y.selectLanguage}
            </p>
            <ul class="max-h-[22rem] overflow-y-auto p-1.5" role="list">
              {
                LOCALES.map((l) => (
                  <li>
                    <a
                      href={localePath(l.code, currentPath)}
                      lang={l.code}
                      hreflang={l.code}
                      class:list={[
                        'flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition-colors',
                        l.code === lang
                          ? 'bg-brand-50 font-bold text-brand-800 dark:bg-brand-500/15 dark:text-brand-200'
                          : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-fg)]',
                      ]}
                      aria-current={l.code === lang ? 'true' : undefined}
                    >
                      <span aria-hidden="true" class="text-base leading-none">{l.flag}</span>
                      <span class="flex-1 truncate">{l.nativeName}</span>
                      {l.dir === 'rtl' && (
                        <span class="gh-chip !px-1.5 !py-0 !text-[0.6rem]">RTL</span>
                      )}
                      {l.code === lang && <Icon name="check" class="h-4 w-4 text-brand-600 dark:text-brand-400" />}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {/* Theme */}
        <div class="relative" data-theme-menu>
          <button
            type="button"
            class="gh-btn gh-btn-sm gh-btn-quiet"
            aria-label={t.a11y.themeSwitch}
            aria-haspopup="true"
            aria-expanded="false"
            data-theme-toggle
          >
            <span class="hidden dark:block"><Icon name="moon" class="h-4 w-4" /></span>
            <span class="block dark:hidden"><Icon name="sun" class="h-4 w-4" /></span>
          </button>

          <div
            class="invisible absolute end-0 top-full z-50 mt-2 w-44 origin-top-right scale-95 overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)] p-1.5 opacity-0 shadow-[var(--shadow-lg)] transition duration-150"
            data-theme-panel
          >
            {(['light', 'dark', 'system'] as const).map((mode) => (
              <button
                type="button"
                class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-start text-sm text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-fg)]"
                data-theme-set={mode}
              >
                <Icon name={mode === 'light' ? 'sun' : mode === 'dark' ? 'moon' : 'monitor'} class="h-4 w-4" />
                {mode === 'light' ? t.nav.themeLight : mode === 'dark' ? t.nav.themeDark : t.nav.themeSystem}
                <span class="ms-auto hidden" data-theme-check={mode}>
                  <Icon name="check" class="h-4 w-4 text-brand-600 dark:text-brand-400" />
                </span>
              </button>
            ))}
          </div>
        </div>

        {/* Primary CTA */}
        <a
          href={localePath(lang, 'platform')}
          class="gh-btn gh-btn-sm gh-btn-primary ms-1 hidden sm:inline-flex"
        >
          {t.nav.getStarted}
          <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
        </a>

        {/* Mobile menu button */}
        <button
          type="button"
          class="gh-btn gh-btn-sm gh-btn-quiet lg:hidden"
          data-open-nav
          aria-label={t.nav.openMenu}
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <Icon name="menu" class="h-5 w-5" />
        </button>
      </div>
    </div>
  </div>

</header>

<style>
  /* Symmetric 3-zone header: brand · centred nav · actions.
     Equal auto tracks keep the nav visually centred at every width. */
  .gh-sym-navbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 0.75rem;
  }
  @media (min-width: 1024px) {
    .gh-sym-navbar {
      grid-template-columns: 1fr auto 1fr;
    }
  }
</style>
