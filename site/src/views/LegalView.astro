---
import Icon from '~/components/Icon.astro';
import { getStrings } from '~/i18n';
import { LEGAL_DOCS } from '~/content/legal';

interface Props {
  lang: string;
  doc: 'privacy' | 'terms';
}
const { lang, doc } = Astro.props;
const t = getStrings(lang);
const content = LEGAL_DOCS[doc];
const title = doc === 'privacy' ? t.footer.privacy : t.footer.terms;
const summary = doc === 'privacy' ? t.pages.legal.privacySummary : t.pages.legal.termsSummary;

// `undefined` would use the build machine's locale, which silently printed
// "January 14, 2026" on the Arabic and Hindi pages.
const updatedFormatted = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(content.updated));
---

<section class="gh-aurora relative overflow-hidden border-b border-[var(--color-line)]" aria-labelledby="legal-title">
  <div class="gh-shell relative py-14 sm:py-20">
    <div class="gh-prose text-center">
      <p class="gh-eyebrow inline-flex">{t.footer.legal}</p>
      <h1 id="legal-title" class="gh-display-2 mt-5 text-[var(--color-fg)]">{title}</h1>
      <p class="mt-4 text-[0.82rem] text-[var(--color-fg-subtle)]">
        {t.pages.legal.lastUpdated}: <time datetime={content.updated}>{updatedFormatted}</time>
      </p>
    </div>
  </div>
</section>

<section class="gh-section">
  <div class="gh-shell">
    <div class="gh-split gh-split-start gap-10 lg:gap-14">
      <!-- ---------------- Table of contents ---------------- -->
      <nav class="lg:sticky lg:top-28 lg:self-start" aria-labelledby="toc-title" data-reveal>
        <h2
          id="toc-title"
          class="flex items-center gap-2 text-[0.72rem] font-bold uppercase tracking-[0.1em] text-[var(--color-fg-subtle)]"
        >
          <Icon name="file" class="h-3.5 w-3.5" />
          {t.pages.legal.contents}
        </h2>
        <ol class="mt-4 flex flex-col gap-1.5">
          {
            content.sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="block rounded-lg px-3 py-1.5 text-[0.84rem] leading-snug text-[var(--color-fg-muted)] transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-fg)]"
                >
                  {section.heading}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <!-- ---------------- Document ---------------- -->
      <article class="min-w-0">
        {
          lang !== 'en' && (
            <div class="mb-8 rounded-2xl border border-brand-200/70 bg-brand-50/70 p-5 dark:border-brand-400/25 dark:bg-brand-500/10" data-reveal>
              <p class="text-[0.78rem] font-bold uppercase tracking-wider text-brand-800 dark:text-brand-200">
                {t.pages.legal.languageSummary}
              </p>
              <p class="mt-2 text-[0.88rem] leading-relaxed text-brand-900 dark:text-brand-100">{summary}</p>
              <p class="mt-3 text-[0.78rem] leading-relaxed text-brand-800/80 dark:text-brand-200/80">
                {t.pages.legal.languageNotice}
              </p>
            </div>
          )
        }

        <div class="space-y-10">
          {
            content.sections.map((section) => (
              <section id={section.id} class="scroll-mt-28" data-reveal>
                <h2 class="font-display text-[1.2rem] font-bold text-[var(--color-fg)]">{section.heading}</h2>
                {section.paragraphs.map((para) => (
                  <p class="mt-3 text-[0.95rem] leading-[1.75] text-[var(--color-fg-muted)]">{para}</p>
                ))}
                {section.bullets && (
                  <ul class="mt-4 grid gap-2.5">
                    {section.bullets.map((bullet) => (
                      <li class="flex items-start gap-2.5 text-[0.92rem] leading-relaxed text-[var(--color-fg-muted)]">
                        <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-500" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </div>

        <div class="mt-12 border-t border-[var(--color-line)] pt-6">
          <a href="#main" class="gh-btn gh-btn-sm gh-btn-ghost" data-back-to-top>
            <Icon name="arrow-up" class="h-4 w-4" />
            {t.pages.legal.backToTop}
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
