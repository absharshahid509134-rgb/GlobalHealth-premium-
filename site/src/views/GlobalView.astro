---
import PageHero from '~/components/PageHero.astro';
import SectionHead from '~/components/SectionHead.astro';
import EmergencyDirectory from '~/components/global/EmergencyDirectory.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon, { type IconName } from '~/components/Icon.astro';
import { getStrings, localePath } from '~/i18n';

interface Props { lang: string }
const { lang } = Astro.props;
const t = getStrings(lang);
const p = t.pages.global;

const PRINCIPLE_ICONS: IconName[] = ['languages', 'file', 'globe', 'zap', 'shield', 'phone'];
---

<PageHero lang={lang} eyebrow={p.eyebrow} title={p.title} lead={p.lead} />

<!-- Localisation principles: six equal cards. -->
<section class="gh-section" aria-labelledby="principles-title">
  <div class="gh-shell">
    <SectionHead
      id="principles-title"
      eyebrow={p.principles.eyebrow}
      title={p.principles.title}
      align="center"
    />

    <div class="mt-11 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        p.principles.items.map((item, i) => (
          <article class="gh-card gh-card-hover flex h-full flex-col p-6" data-reveal>
            <span class="gh-icon-tile gh-icon-tile-md">
              <Icon name={PRINCIPLE_ICONS[i]} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 font-display text-[1.02rem] font-bold text-[var(--color-fg)]">{item.title}</h3>
            <p class="mt-2 flex-1 text-[0.86rem] leading-relaxed text-[var(--color-fg-muted)]">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Emergency directory: the highest-value block on the page, so it sits
     above the fold of its own section. -->
<EmergencyDirectory lang={lang} />

<!-- Region coverage -->
<section class="gh-section gh-band" aria-labelledby="regions-title">
  <div class="gh-shell">
    <SectionHead id="regions-title" eyebrow={p.regions.eyebrow} title={p.regions.title} align="center" />

    <ul class="mt-11 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
      {
        p.regions.items.map((r) => (
          <li class="gh-card flex h-full flex-col p-5" data-reveal>
            <div class="flex items-center gap-2.5">
              <span class="gh-icon-tile h-8 w-8 shrink-0">
                <Icon name="globe" class="h-4 w-4" />
              </span>
              <h3 class="text-[0.95rem] font-bold text-[var(--color-fg)]">{r.region}</h3>
            </div>
            <p class="mt-3 text-[0.82rem] leading-relaxed text-[var(--color-fg-muted)]">{r.countries}</p>
            <p class="mt-2 text-[0.76rem] font-semibold text-brand-700 dark:text-brand-300">{r.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<CtaBand
  lang={lang}
  id="global-cta"
  title={t.home.cta.title}
  lead={t.home.cta.lead}
  primaryLabel={t.home.cta.primary}
  primaryHref={localePath(lang, 'platform')}
  secondaryLabel={t.home.cta.secondary}
  note={t.home.cta.note}
/>
